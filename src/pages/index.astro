---
import BaseLayout from "@/layouts/base-layout.astro";
import Logo from "@/assets/logo.svg";
---

<BaseLayout>
  <header>
    <h1 aria-label="Mewo"><Logo /></h1>
  </header>

  <main>
    <section>
      <h2 id="about">Desktop shader editor</h2>
      <p>
        Mewo is a shader development environment built for creative coding,
        testing, and experimentation. It focuses on reducing friction: quick to
        launch, easy to use, and very customizable.
      </p>
      <p>
        Source code can be <a href="https://github.com/aczw/mewo"
          >found on GitHub</a
        > and downloads can be found <a
          href="https://github.com/aczw/mewo/releases">on the Releases</a
        > page.
      </p>
    </section>

    <section>
      <h2 id="blog">Dev blog</h2>
      <p>
        Read about the development process and watch me slowly go insane. Coming
        soon!
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  header {
    padding: 3rem 1rem;
    max-width: var(--content-w);
    margin-inline: auto;
  }

  main {
    padding-inline: 1rem;
    max-width: var(--content-w);
    margin-inline: auto;

    > section {
      > h2 {
        font: 3rem "League Gothic";
        margin-block-end: 1.5rem;
      }

      > p:not(:last-child) {
        margin-block-end: 1.5rem;
      }

      &:not(:last-child) {
        margin-block-end: 3rem;
      }
    }
  }
</style>
