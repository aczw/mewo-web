---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/base-layout.astro";
import Logo from "@/assets/logo.svg";

const MONTH_DAY = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const blogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BaseLayout>
  <header>
    <h1 aria-label="Mewo"><Logo /></h1>
  </header>

  <main>
    <section>
      <h2 id="about">Desktop shader editor</h2>
      <p>
        Mewo is a shader development environment built for creative coding,
        testing, and experimentation. It focuses on reducing friction by being
        quick to launch, easy to use, and very customizable.
      </p>
      <p>
        Source code can be <a
          href="https://github.com/aczw/mewo"
          target="_blank">found on GitHub</a
        > and downloads can be found <a
          href="https://github.com/aczw/mewo/releases"
          target="_blank">on the Releases</a
        > page. <span style="font-style: italic;">
          Beta is out! You (still) probably shouldn't use it.</span
        >
      </p>
    </section>

    <section>
      <h2 id="blog">Dev blog</h2>
      <p>
        I write about the development process and stuff I find interesting. See
        me slowly going insane! <span style="font-style: italic;"
          >Coming soon.</span
        >
      </p>

      <ul class="blog-entries">
        {
          blogPosts.map(({ data: { title, published }, id }, index) => (
            <li>
              <span class="bullet" aria-hidden="true">
                {index + 1}
              </span>

              <a href={`/blog/${id}`}>
                <span class="title">{title}</span>
                <time
                  style="font-style: italic;"
                  datetime={published.toISOString()}
                >
                  {MONTH_DAY.format(published)}
                </time>
              </a>
            </li>
          ))
        }

        {
          Array.from({ length: 3 }).map((_, index) => (
            <li>
              <span class="bullet" aria-hidden="true">
                {index + 2}
              </span>

              <a href="/">
                <span class="title">test</span>
                <span style="font-style: italic;">September 6</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  header {
    padding: 3rem 1rem;
    max-width: var(--content-w);
    margin-inline: auto;
  }

  main {
    padding-inline: 1rem;
    max-width: var(--content-w);
    margin-inline: auto;

    a {
      color: var(--col-black);
      text-decoration: underline;
    }

    > section {
      > h2 {
        font: 3rem "League Gothic";
        margin-block-end: 1.75rem;
      }

      > p:not(:last-child) {
        margin-block-end: 1.5rem;
      }

      &:not(:last-child) {
        margin-block-end: 3rem;
      }

      > ul.blog-entries {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;

        list-style: none;
        padding: 0px;

        > li {
          --bullet-size: 22px;

          display: flex;
          gap: 0.85rem;

          > span.bullet {
            display: flex;
            align-items: center;
            justify-content: center;

            background-color: var(--col-dark-blue);
            color: var(--col-light-blue);
            border-radius: 9999px;
            cursor: default;
            user-select: none;
            flex-shrink: 0;

            width: var(--bullet-size);
            height: var(--bullet-size);
          }

          > a {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;

            text-decoration: none;
            flex-grow: 1;

            > span.title {
              font-weight: 600;
            }
          }
        }
      }
    }
  }
</style>
